{% render 'partials/head.liquid', title: 'Squad page' %}
<main>
  <h1>Squad page</h1>

  <form class="filter-team">
    <label>
    <select name="team" id="team">
      <option value="">Kies een team</option>
      <option value="bliss">bliss</option>
      <option value="delight">delight</option>
      <option value="fun">fun</option>
      <option value="happy">happy</option>
      <option value="jolly">jolly</option>
      <option value="joy">joy</option>
      <option value="cheer">cheer</option>
      <option value="dazzle">dazzle</option>
      <option value="glow">glow</option>
      <option value="radiant">radiant</option>
      <option value="spark">spark</option>
      <option value="sunny">sunny</option>
    </select>
  </label>
  </form>

  <form class="filter-squad">
    <label>
      <select name="squad" id="squad">
        <option value="">Filter squad</option>
        <option value="squad-1I">Squad 1I</option>
        <option value="squad-1J">Squad 1J</option>
      </select>
    </label>
  </form>
  <h2>Students</h2>
  
  <ul class="card">
      {% for person in persons %}
  <li class="student-card" 
      style="--background-color: {{ person.fav_color }}">
      <img src="https://fdnd.directus.app/assets/{{ person.mugshot }}?width=300" alt="Profile picture">

    {% if person.profilecard %}
      {% assign link = person.profilecard %}
    {% elsif person.website %}
      {% assign link = person.website %}
    {% else %}
      {% assign link = "https://github.com/" | append: person.github_handle | append: "/connect-your-tribe-squad-page" %}
    {% endif %}

    <a class="dossier card-link" href="{{ link }}" target="_blank" rel="noopener">
      <span class="name-nickname">{{ person.name }}</span>
    </a>

  </li>
{% endfor %}
  </ul>
</main>
{% render 'partials/foot.liquid', squads: squads %}